[importlinter]
root_package = agentbox


# ─── Agents domain facade ────────────────────────────────────────────────
# External callers may only touch the facade modules (core.agents and
# core.service.agents). Reaching past them into composition, resolve
# internals, or per-version write modules locks callers to the current
# layout and silently couples interfaces to private structure.
[importlinter:contract:agents-facade]
name = Agents domain facade
type = forbidden
source_modules =
    agentbox.api
    agentbox.cli
    agentbox.mcp
    agentbox.core.execution
forbidden_modules =
    agentbox.core.agents.composition.bundle
    agentbox.core.agents.composition.versioning
    agentbox.core.agents.config
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =


# ─── Interface boundary ──────────────────────────────────────────────────
# api/cli/mcp call business logic via core.service only. core.data
# (records, enums, store) and core.constants are also allowed since they
# are leaf-data layers shared across the whole codebase. Direct imports of
# any other core.* submodule are forbidden so the facade stays the only
# place that ever moves when internals are refactored.
#
# The ignore_imports block below is the known-debt registry: every line is
# a direct import the facade hasn't yet absorbed. Pay it down by adding a
# core.service re-export and rerouting the caller.
[importlinter:contract:interface-facade]
name = Interface layers go through core.service
type = forbidden
source_modules =
    agentbox.api
    agentbox.cli
    agentbox.mcp
forbidden_modules =
    agentbox.core.agents
    agentbox.core.engines
    agentbox.core.execution
    agentbox.core.resources
    agentbox.core.workspaces
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =
    # api → core.agents
    agentbox.api.engines.backends -> agentbox.core.agents.resolve
    # api → core.engines
    agentbox.api.engines.backends -> agentbox.core.engines
    agentbox.api.engines.providers -> agentbox.core.engines
    # api → core.workspaces
    agentbox.api.agents.grants -> agentbox.core.workspaces.catalog
    agentbox.api.workspaces.catalog -> agentbox.core.workspaces.catalog
    agentbox.api.workspaces.crud -> agentbox.core.workspaces.build
    # api → core.execution
    agentbox.api.runs.webhooks -> agentbox.core.execution.dispatch
    agentbox.api.runs.webhooks -> agentbox.core.execution.dispatch.payload
    agentbox.api.runs.webhooks -> agentbox.core.execution.dispatch.policy
    # cli → core.agents
    agentbox.cli.engine.backend -> agentbox.core.agents.resolve
    # cli → core.engines
    agentbox.cli.engine.backend -> agentbox.core.engines
    agentbox.cli.engine.cred -> agentbox.core.engines.credentials
    agentbox.cli.engine.cred -> agentbox.core.engines.credentials.builtin
    agentbox.cli.engine.provider -> agentbox.core.engines
    agentbox.cli.system.doctor -> agentbox.core.engines
    agentbox.cli.root -> agentbox.core.engines
    # cli → core.resources
    agentbox.cli.ops.resource.repo -> agentbox.core.resources.legacy_composition
    agentbox.cli.resources.repo.manage -> agentbox.core.resources.legacy_composition
    # cli → core.workspaces
    agentbox.cli.ops.cfg -> agentbox.core.workspaces
    agentbox.cli.ops.shell -> agentbox.core.workspaces.prep
    agentbox.cli.ops.workenv -> agentbox.core.workspaces.generation.builders.from_db
    agentbox.cli.ops.workenv -> agentbox.core.workspaces.generation.builders.from_yaml
    agentbox.cli.ops.workenv -> agentbox.core.workspaces.generation.builders.interactive
    agentbox.cli.ops.workenv -> agentbox.core.workspaces.generation.config
    agentbox.cli.ops.workenv -> agentbox.core.workspaces.generation.generator
    agentbox.cli.ops.workenv -> agentbox.core.workspaces.generation.presets
    agentbox.cli.ops.workenv -> agentbox.core.workspaces.generation.recipe
    agentbox.cli.ops.launch -> agentbox.core.workspaces.build
    agentbox.cli.root -> agentbox.core.workspaces
    agentbox.cli.system.doctor -> agentbox.core.workspaces
    agentbox.cli.work.ws -> agentbox.core.workspaces
    # mcp → core.execution
    agentbox.mcp.tools.runs -> agentbox.core.execution.observability.conversation
    agentbox.mcp.tools.runs -> agentbox.core.execution.observability.conversation.transcript


# ─── Resources is the foundation ─────────────────────────────────────────
# Per APP_DOMAINS, resources sits at the bottom of the tree: agents and
# workspace depend on it; it depends on nothing else. Any direct import
# from resources into a peer domain is a layering inversion.
[importlinter:contract:resources-foundation]
name = Resources is the foundation
type = forbidden
source_modules =
    agentbox.core.resources
forbidden_modules =
    agentbox.core.agents
    agentbox.core.engines
    agentbox.core.execution
    agentbox.core.workspaces
allow_indirect_imports = True


# ─── Engines: only Tools + leaves ────────────────────────────────────────
# Engines is the catalog of backends/providers/credentials. Per
# APP_DOMAINS it sits below agents and above resources; it must never
# reach up into agents, workspace, or execution.
#
# Known debt below: Plan 051 moved backend conversation decoders into
# core.engines.backends.<name>/conversation.py; they still import the
# base/types/transcript from core.execution.observability.conversation.
# Real fix: move shared conversation primitives to a neutral runtime layer.
[importlinter:contract:engines-position]
name = Engines must not import higher domains
type = forbidden
source_modules =
    agentbox.core.engines
forbidden_modules =
    agentbox.core.agents
    agentbox.core.execution
    agentbox.core.workspaces
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =
    # engines → execution (conversation decoders from Plan 051)
    agentbox.core.engines.backends.claude_code.conversation -> agentbox.core.execution.observability.conversation.base
    agentbox.core.engines.backends.claude_code.conversation -> agentbox.core.execution.observability.conversation.types
    agentbox.core.engines.backends.codex.conversation -> agentbox.core.execution.observability.conversation.base
    agentbox.core.engines.backends.codex.conversation -> agentbox.core.execution.observability.conversation.types
    agentbox.core.engines.backends.opencode.conversation -> agentbox.core.execution.observability.conversation.base
    agentbox.core.engines.backends.opencode.conversation -> agentbox.core.execution.observability.conversation.types
    agentbox.core.engines.backends.pi.conversation -> agentbox.core.execution.observability.conversation.base
    agentbox.core.engines.backends.pi.conversation -> agentbox.core.execution.observability.conversation.types
    agentbox.core.engines.backends.token.conversation -> agentbox.core.execution.observability.conversation.base
    agentbox.core.engines.backends.token.conversation -> agentbox.core.execution.observability.conversation.transcript
    agentbox.core.engines.backends.token.conversation -> agentbox.core.execution.observability.conversation.types
    # engines → workspaces (backend renderers consume WorkenvConfig/payload
    # from workspaces.generation; real fix: move those value types to a
    # neutral layer below both domains)
    agentbox.core.engines.backends.codex.render -> agentbox.core.workspaces.generation.config
    agentbox.core.engines.backends.codex.render -> agentbox.core.workspaces.generation.payload
    agentbox.core.engines.backends.opencode.adapter -> agentbox.core.workspaces.generation.config
    agentbox.core.engines.backends.opencode.adapter -> agentbox.core.workspaces.generation.payload
    agentbox.core.engines.backends.opencode.render -> agentbox.core.workspaces.generation.config
    agentbox.core.engines.backends.opencode.render -> agentbox.core.workspaces.generation.payload
    agentbox.core.engines.backends.token.tools -> agentbox.core.workspaces.generation.inject
    agentbox.core.engines.backends.token.tools -> agentbox.core.workspaces.permissions
    agentbox.core.engines.contracts.base -> agentbox.core.workspaces.generation.config
    agentbox.core.engines.contracts.base -> agentbox.core.workspaces.generation.payload


# ─── Agents ⟂ Workspace (peer rule) ──────────────────────────────────────
# Per APP_DOMAINS, agents and workspace are siblings under execution.
# Neither may import the other; cross-domain operations go through
# core.service.
[importlinter:contract:agents-peer]
name = Agents and workspace are independent peers
type = forbidden
source_modules =
    agentbox.core.agents
forbidden_modules =
    agentbox.core.workspaces
    agentbox.core.execution
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =
    # agents.runtime prepares workspaces during agent execution
    agentbox.core.agents.runtime -> agentbox.core.workspaces.prep


[importlinter:contract:workspace-peer]
name = Workspace cannot import agents or execution
type = forbidden
source_modules =
    agentbox.core.workspaces
forbidden_modules =
    agentbox.core.agents
    agentbox.core.execution
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =


# ─── Data layer purity (CORE_ARCHITECTURE §1) ────────────────────────────
# Managers translate requests into SQL and nothing else. core.db must
# never reach up into domain packages or the service layer — if a manager
# needs domain logic, the logic is in the wrong layer.
[importlinter:contract:data-layer-purity]
name = Data layer imports no domain or service code
type = forbidden
source_modules =
    agentbox.core.db
forbidden_modules =
    agentbox.core.service
    agentbox.core.agents
    agentbox.core.engines
    agentbox.core.execution
    agentbox.core.resources
    agentbox.core.tools
    agentbox.core.workspaces
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =
    # db → workspaces (host-env grant resolution reaches into the
    # permissions artifact; real fix: move the shared permission types
    # down, or resolve grants in the workspaces domain instead)
    agentbox.core.db.workspaces.host_env -> agentbox.core.workspaces.permissions


# ─── Domains never import Services (CORE_ARCHITECTURE §2) ────────────────
# The dependency arrow points down: Services orchestrate domains, never
# the reverse. A domain importing core.service is a layering inversion.
[importlinter:contract:domains-below-services]
name = Domain packages never import the service layer
type = forbidden
source_modules =
    agentbox.core.agents
    agentbox.core.db
    agentbox.core.engines
    agentbox.core.execution
    agentbox.core.resources
    agentbox.core.tools
    agentbox.core.workspaces
forbidden_modules =
    agentbox.core.service
allow_indirect_imports = True


# ─── Interface layers stay out of core.db (CORE_ARCHITECTURE §3) ─────────
# api/cli/mcp get their data through core.service; handing them Database /
# SessionStore / managers couples the interface to the persistence layout.
# The ignore_imports block is the known-debt registry — pay it down by
# routing the caller through a Service.
[importlinter:contract:interface-no-db]
name = Interface layers do not import core.db
type = forbidden
source_modules =
    agentbox.api
    agentbox.cli
    agentbox.mcp
forbidden_modules =
    agentbox.core.db
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =
    # DI wiring still constructs Database/SessionStore directly; goes
    # away when deps modules resolve Services instead
    agentbox.api.deps -> agentbox.core.db
    agentbox.cli._deps -> agentbox.core.db
    agentbox.cli.shared.deps -> agentbox.core.db
    agentbox.mcp.deps -> agentbox.core.db
    # remaining direct store/row consumers
    agentbox.api.workspaces.catalog -> agentbox.core.db
    agentbox.api.workspaces.crud -> agentbox.core.db
    agentbox.cli.agent.definition -> agentbox.core.db
    agentbox.cli.ops.migrate -> agentbox.core.db.system.seeds
    agentbox.cli.ops.shell -> agentbox.core.db
    agentbox.cli.ops.workenv -> agentbox.core.db
