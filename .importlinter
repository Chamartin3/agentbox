[importlinter]
root_package = agentbox
include_external_packages = True


# ─── Agents domain facade ────────────────────────────────────────────────
# External callers may only touch the facade modules (core.agents and
# core.service.agents). Reaching past them into composition, resolve
# internals, or per-version write modules locks callers to the current
# layout and silently couples interfaces to private structure.
[importlinter:contract:agents-facade]
name = Agents domain facade
type = forbidden
source_modules =
    agentbox.api
    agentbox.cli
    agentbox.mcp
    agentbox.core.execution
forbidden_modules =
    agentbox.core.agents.composition.bundle
    agentbox.core.agents.composition.versioning
    agentbox.core.agents.config
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =


# ─── Interface boundary ──────────────────────────────────────────────────
# api/cli/mcp call business logic via core.service only. core.data
# (records, enums, store) and core.constants are also allowed since they
# are leaf-data layers shared across the whole codebase. Direct imports of
# any other core.* submodule are forbidden so the facade stays the only
# place that ever moves when internals are refactored.
#
# The ignore_imports block below is the known-debt registry: every line is
# a direct import the facade hasn't yet absorbed. Pay it down by adding a
# core.service re-export and rerouting the caller.
[importlinter:contract:interface-facade]
name = Interface layers go through core.service
type = forbidden
source_modules =
    agentbox.api
    agentbox.cli
    agentbox.mcp
forbidden_modules =
    agentbox.core.agents
    agentbox.core.engines
    agentbox.core.execution
    agentbox.core.resources
    agentbox.core.workspaces
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =
    # api → core.workspaces (reads filesystem workspace info via the `ws` helper)
    agentbox.api.workspaces.crud -> agentbox.core.workspaces
    # cli render layer touches workspace domain types to format output
    # (real fix: shared value types below both layers)
    agentbox.cli.shared.renderers.workspace -> agentbox.core.workspaces
    # api → core.execution
    agentbox.api.runs.webhooks -> agentbox.core.execution.dispatch
    agentbox.api.runs.webhooks -> agentbox.core.execution.dispatch.payload
    agentbox.api.runs.webhooks -> agentbox.core.execution.dispatch.policy
    # cli → core.resources
    agentbox.cli.ops.resource.repo -> agentbox.core.resources.legacy_composition
    # cli → core.workspaces
    agentbox.cli.ops.cfg -> agentbox.core.workspaces
    agentbox.cli.ops.shell -> agentbox.core.workspaces.prep
    agentbox.cli.ops.workenv -> agentbox.core.workspaces.generation.builders.from_yaml
    agentbox.cli.ops.workenv -> agentbox.core.workspaces.generation.builders.interactive
    agentbox.cli.ops.workenv -> agentbox.core.workspaces.generation.config
    agentbox.cli.system.doctor -> agentbox.core.workspaces
    agentbox.cli.work.ws -> agentbox.core.workspaces
    # cli renderers → core.engines (render layer touches domain types to
    # produce formatted output; real fix: shared value types below both layers)
    # cli renderers → core.workspaces (same rationale)
    # api/cli DI wiring constructs the executor + MCP client directly
    # (burned when DI routes through core.service — UNIFIED / 113_04)
    agentbox.api.deps -> agentbox.core.execution.orchestrate.executor
    agentbox.cli.shared.deps -> agentbox.core.execution.orchestrate.executor
    agentbox.api.deps -> agentbox.core.workspaces.mcp.client
    agentbox.cli.shared.deps -> agentbox.core.workspaces.mcp.client
    agentbox.api.agents.grants -> agentbox.core.workspaces.mcp.client.registry
    agentbox.api.workspaces.catalog -> agentbox.core.workspaces.mcp.client.registry
    agentbox.cli.ops.launch -> agentbox.core.workspaces.mcp.client


# ─── Resources is the foundation ─────────────────────────────────────────
# Per APP_DOMAINS, resources sits at the bottom of the tree: agents and
# workspace depend on it; it depends on nothing else. Any direct import
# from resources into a peer domain is a layering inversion.
[importlinter:contract:resources-foundation]
name = Resources is the foundation
type = forbidden
source_modules =
    agentbox.core.resources
forbidden_modules =
    agentbox.core.agents
    agentbox.core.engines
    agentbox.core.execution
    agentbox.core.workspaces
allow_indirect_imports = True


# ─── CLI architecture: context owns the DI wiring ─────────────────────────
# CLI branch packages (agent, engine, history, ops, run, system, work)
# must not import agentbox.cli.shared.deps directly — the singleton
# factories are owned by the context layer. Branches get their services
# via ctx.obj (CLIContext), not by calling factories. Violations that
# remain are transitional debt tracked in ignore_imports below.
[importlinter:contract:cli-context-owns-core]
name = CLI branches must not import shared.deps
type = forbidden
source_modules =
    agentbox.cli.agent
    agentbox.cli.engine
    agentbox.cli.history
    agentbox.cli.ops
    agentbox.cli.run
    agentbox.cli.system
    agentbox.cli.work
forbidden_modules =
    agentbox.cli.shared.deps
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =
    # agents/engine/history/run/system/work branch packages still import
    # factories from shared.deps before ctx.obj migration is complete
    agentbox.cli.ops.resource.bind -> agentbox.cli.shared.deps
    agentbox.cli.ops.resource.repo -> agentbox.cli.shared.deps
    agentbox.cli.work.res -> agentbox.cli.shared.deps
    # ops composition-root commands legitimately open a Database via get_db
    # (migrate bootstraps alembic; shell is a debug REPL)
    agentbox.cli.ops.migrate -> agentbox.cli.shared.deps
    agentbox.cli.ops.shell -> agentbox.cli.shared.deps

# ─── CLI architecture: only render layer touches Rich ────────────────────
# The Rich console library must only be imported by the render layer
# (agentbox.cli.shared.render and agentbox.cli.shared.renderers.*).
# Branch packages format output through the Renderer subclasses stored
# in ctx.obj.render — they must not import Rich directly.
[importlinter:contract:cli-render-owns-rich]
name = CLI branches must not import Rich directly
type = forbidden
source_modules =
    agentbox.cli.agent
    agentbox.cli.engine
    agentbox.cli.history
    agentbox.cli.ops
    agentbox.cli.run
    agentbox.cli.system
    agentbox.cli.work
forbidden_modules =
    rich
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn

# ─── Engines: only Tools + leaves ────────────────────────────────────────
# Engines is the catalog of backends/providers/credentials. Per
# APP_DOMAINS it sits below agents and above resources; it must never
# reach up into agents, workspace, or execution.
#
# Known debt below: Plan 051 moved backend conversation decoders into
# core.engines.backends.<name>/conversation.py; they still import the
# base/types/transcript from core.execution.observability.conversation.
# Real fix: move shared conversation primitives to a neutral runtime layer.
[importlinter:contract:engines-position]
name = Engines must not import higher domains
type = forbidden
source_modules =
    agentbox.core.engines
forbidden_modules =
    agentbox.core.agents
    agentbox.core.execution
    agentbox.core.workspaces
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =
    # engines.backends.token.tools reaches into workspaces for the in-process
    # host-env MCP toolset (inject.py) and grant checks (permissions.py).
    # These are intentional: the token backend must spawn the same host-env
    # server as the MCP-aware backends.
    agentbox.core.engines.backends.token.tools -> agentbox.core.workspaces.generation.inject
    agentbox.core.engines.backends.token.tools -> agentbox.core.workspaces.permissions


# ─── Agents ⟂ Workspace (peer rule) ──────────────────────────────────────
# Per APP_DOMAINS, agents and workspace are siblings under execution.
# Neither may import the other; cross-domain operations go through
# core.service.
[importlinter:contract:agents-peer]
name = Agents and workspace are independent peers
type = forbidden
source_modules =
    agentbox.core.agents
forbidden_modules =
    agentbox.core.workspaces
    agentbox.core.execution
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =
    # agents.runtime prepares workspaces during agent execution
    agentbox.core.agents.runtime -> agentbox.core.workspaces.prep


[importlinter:contract:workspace-peer]
name = Workspace cannot import agents or execution
type = forbidden
source_modules =
    agentbox.core.workspaces
forbidden_modules =
    agentbox.core.agents
    agentbox.core.execution
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =


# ─── Data layer purity (CORE_ARCHITECTURE §1) ────────────────────────────
# Managers translate requests into SQL and nothing else. core.db must
# never reach up into domain packages or the service layer — if a manager
# needs domain logic, the logic is in the wrong layer.
[importlinter:contract:data-layer-purity]
name = Data layer imports no domain or service code
type = forbidden
source_modules =
    agentbox.core.db
forbidden_modules =
    agentbox.core.service
    agentbox.core.agents
    agentbox.core.engines
    agentbox.core.execution
    agentbox.core.resources
    agentbox.core.tools
    agentbox.core.workspaces
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =
    # db → workspaces (host-env grant resolution reaches into the
    # permissions artifact; real fix: move the shared permission types
    # down, or resolve grants in the workspaces domain instead)


# ─── core.service intra-domain layering (plan 110) ───────────────────────────
# The service subdomains form a DAG: lifecycle orchestrates everything; each
# lower layer may import from layers further down but never from layers above.
#
#   lifecycle  (top — orchestrates all domains at startup)
#   workspaces
#   execution | resources  (independent peers; neither imports the other)
#   agents
#   engines
#   evaluation | system  (leaf services — no cross-service imports)
#
# This contract catches the "facade back-edge" anti-pattern that caused the
# pre-plan-110 cycles: a submodule importing via its own package __init__.
[importlinter:contract:service-layers]
name = core.service subdomains are acyclically layered
type = layers
containers =
    agentbox.core.service
layers =
    lifecycle
    workspaces
    execution | resources
    agents
    engines
    evaluation | system


# ─── Domains never import Services (CORE_ARCHITECTURE §2) ────────────────
# The dependency arrow points down: Services orchestrate domains, never
# the reverse. A domain importing core.service is a layering inversion.
[importlinter:contract:domains-below-services]
name = Domain packages never import the service layer
type = forbidden
source_modules =
    agentbox.core.agents
    agentbox.core.db
    agentbox.core.engines
    agentbox.core.execution
    agentbox.core.resources
    agentbox.core.tools
    agentbox.core.workspaces
forbidden_modules =
    agentbox.core.service
allow_indirect_imports = True


# ─── Interface layers stay out of core.db (CORE_ARCHITECTURE §3) ─────────
# api/cli/mcp get their data through core.service; handing them Database /
# SessionStore / managers couples the interface to the persistence layout.
# The ignore_imports block is the known-debt registry — pay it down by
# routing the caller through a Service.
[importlinter:contract:interface-no-db]
name = Interface layers do not import core.db
type = forbidden
source_modules =
    agentbox.api
    agentbox.cli
    agentbox.mcp
forbidden_modules =
    agentbox.core.db
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =
    # DI wiring constructs Database directly from core.db.database; goes
    # away when deps modules resolve Services instead (plan 113_04).
    # After plan 109, Database/get_database are in core.db.database, not the
    # top-level facade, so we point at the specific submodule:
    agentbox.api.deps -> agentbox.core.db.database
    agentbox.cli.shared.deps -> agentbox.core.db.database
    agentbox.mcp.deps -> agentbox.core.db.database
    # migration tooling: always-tolerated deep submodule path
    agentbox.cli.ops.migrate -> agentbox.core.db.system.seeds
    # cli renderers touch core.db types to render domain objects
    # (real fix: shared value types below both layers)
    # api/mcp transitional direct db access (TODO: route through Services)


# ─── db façade is managers-only ──────────────────────────────────────────
# Everything outside core.db (and its own tests) imports managers via the
# top façade ``agentbox.core.db``, never a deep submodule.  Shared data
# shapes live in core.data / core.protocols / core.events, not here.
# The ignore_imports block is the known-debt registry — one line per debt
# site, each tagged with the plan that burns it.
[importlinter:contract:db-facade-managers-only]
name = core.db exposes only managers via its façade
type = forbidden
source_modules =
    agentbox.core.agents
    agentbox.core.engines
    agentbox.core.execution
    agentbox.core.resources
    agentbox.core.service
    agentbox.core.tools
    agentbox.core.workspaces
forbidden_modules =
    agentbox.core.db.schema
    agentbox.core.db.base
    agentbox.core.db.models
    agentbox.core.db.store
    agentbox.core.db.database
    agentbox.core.db.managers
    agentbox.core.db.agents
    agentbox.core.db.workspaces
    agentbox.core.db.resources
    agentbox.core.db.engines
    agentbox.core.db.system
    agentbox.core.db.execution
allow_indirect_imports = True
unmatched_ignore_imports_alerting = warn
ignore_imports =
    # ── Permanent allowlist (composition root — Database lifecycle) ──────
    agentbox.core.service.base -> agentbox.core.db.database
    # ── Transitional: burned by plans 111/112 ────────────────────────────
    agentbox.core.execution.orchestrate.executor -> agentbox.core.db.database
    agentbox.core.execution.orchestrate.init_run -> agentbox.core.db.schema
    agentbox.core.execution.orchestrate.init_run -> agentbox.core.db.database
    agentbox.core.service.agents.crud -> agentbox.core.db.schema
    agentbox.core.service.lifecycle.startup -> agentbox.core.db.database
    agentbox.core.service.workspaces.registry -> agentbox.core.db.database
    # ── Transitional: burned by plan 110 (mcp/server re-plumb) ──────────
    agentbox.core.workspaces.mcp.servers.agent_tools.context -> agentbox.core.db.database
    agentbox.core.workspaces.mcp.servers.agent_tools.context -> agentbox.core.db.system.config
    agentbox.core.workspaces.mcp.servers.host_env.context -> agentbox.core.db.database
    agentbox.core.workspaces.mcp.servers.host_env.context -> agentbox.core.db.system.config
    # ── Pre-existing deep imports (no manager API yet): ──────────────────
    agentbox.core.agents.runtime -> agentbox.core.db.system.config
    agentbox.core.engines.defaults -> agentbox.core.db.system.config
    agentbox.core.execution.observability.snapshot.mcp -> agentbox.core.db.system.config
    agentbox.core.resources -> agentbox.core.db.resources.models
    agentbox.core.service.lifecycle.startup -> agentbox.core.db.engines.seeds
    agentbox.core.workspaces.generation.builders.from_db -> agentbox.core.db.system.config
